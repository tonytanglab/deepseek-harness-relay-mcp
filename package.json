{
  "name": "dsh-agents-relay",
  "version": "0.1.5",
  "description": "Web-profile helper plus an MCP stdio that attaches Codex, Cursor, or Claude Code to an already-running Harness Web",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "pnpm-workspace.yaml",
    "skill",
    "prepare.mjs"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./mcp": "./lib/mcp.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-relay-mcp": "./lib/mcp.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonytanglab/deepseek-harness-relay-mcp.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "node prepare.mjs",
    "prepack": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-commands": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=3.18.1-rc.1 <4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "node-addon-require-builtin": "^0.1.4",
    "@deepseek-ai/schemastery": "3.18.1",
    "tsdown": "^0.22.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
